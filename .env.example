# Postgres
POSTGRES_PORT=5432
POSTGRES_DB=web_app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changepassword

# Backend Postgres client
BACKEND_DATABASE_URL=

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Backend Redis client
BACKEND_REDIS_URL=
BACKEND_REDIS_DB=0
BACKEND_REDIS_PREFIX=web-app
BACKEND_REDIS_MAX_CONNECTIONS=20
BACKEND_REDIS_SOCKET_CONNECT_TIMEOUT=2
BACKEND_REDIS_SOCKET_TIMEOUT=2
BACKEND_REDIS_HEALTH_CHECK_INTERVAL=30

# Backend
BACKEND_CORS_ORIGINS=["http://localhost:5173"]
BACKEND_WORKERS=4
BACKEND_PORT=8000
BACKEND_LOG_LEVEL=INFO
BACKEND_LOG_JSON=false
