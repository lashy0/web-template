# Routing
BASE_DOMAIN=localhost

# PostgreSQL infrastructure
POSTGRES_PORT=5432
POSTGRES_ADMIN_PASSWORD=replace-with-admin-secret
POSTGRES_MIGRATOR_PASSWORD=replace-with-migrator-secret
POSTGRES_RUNTIME_PASSWORD=replace-with-runtime-secret

# Redis infrastructure
REDIS_PORT=6379
REDIS_ADMIN_PASSWORD=replace-with-admin-secret
REDIS_RUNTIME_PASSWORD=replace-with-runtime-secret

# Ory Kratos infrastructure
KRATOS_POSTGRES_MIGRATOR_PASSWORD=replace-with-kratos-migrator-secret
KRATOS_POSTGRES_RUNTIME_PASSWORD=replace-with-kratos-runtime-secret
# Cookie and cipher secrets live in infrastructure/identity/.env.

# Backend
BACKEND_CORS_ORIGINS='["http://localhost:5173"]'
BACKEND_WORKERS=4
BACKEND_LOG_LEVEL=INFO
BACKEND_LOG_JSON=false

# First administrator. Set exactly one password source before the first start.
BACKEND_BOOTSTRAP_ADMIN_LOGIN=admin
BACKEND_BOOTSTRAP_ADMIN_NAME=Администратор
# BACKEND_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-12+-character-password
# BACKEND_BOOTSTRAP_ADMIN_PASSWORD_FILE=/run/secrets/bootstrap_admin_password
