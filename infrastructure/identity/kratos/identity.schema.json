{
  "$id": "https://schemas.web-app.local/kratos/identity.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Web App identity",
  "type": "object",
  "properties": {
    "traits": {
      "type": "object",
      "properties": {
        "login": {
          "type": "string",
          "title": "Login",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$",
          "ory.sh/kratos": {
            "credentials": {
              "password": {
                "identifier": true
              }
            }
          }
        }
      },
      "required": ["login"],
      "additionalProperties": false
    }
  },
  "required": ["traits"],
  "additionalProperties": false
}
