# Dashboard
TRAEFIK_USERNAME=replace-with-dashboard-username
TRAEFIK_HASHED_PASSWORD=replace-with-pre-hashed-password
# Production only: the server's local-network address the dashboard port is
# bound to, such as 192.168.1.10.
TRAEFIK_DASHBOARD_ADDRESS=

# Production only: the address Let's Encrypt registers the certificates for.
ACME_EMAIL=
