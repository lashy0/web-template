# Copy to scenarios/.env, next to the scenario.

# The application address: http://${APP_HOST} from the root .env.
PAK_SIM_SERVER=http://localhost

# The PAK code and OAuth credentials, from the PAK card in the application.
PAK1_CODE=
PAK1_CLIENT_ID=
PAK1_ACCESS_KEY=

# The first DevEUI and the number of consecutive units from a batch.
PAK1_DEV_EUI_FROM=0016C00003000001
PAK1_DEV_EUI_COUNT=20
